      }
    }
  },
  "definitions": {
    "PluginDescriptor": {
      "type": "object",
      "required": [
        "capabilities",
        "contentDigest",
        "id",
        "state",
        "version"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contentDigest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
