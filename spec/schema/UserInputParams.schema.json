{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserInputParams",
  "type": "object",
  "required": [
    "prompt",
    "threadId",
    "turnId"
  ],
  "properties": {
    "metadata": {
      "default": null
    },
    "prompt": {
      "type": "string"
    },
    "threadId": {
      "type": "string",
      "format": "uuid"
    },
    "turnId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
