{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelEvent",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "text",
        "type"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "text_delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "text",
        "type"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "reasoning_delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "call_id",
        "json_delta",
        "name",
        "type"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "json_delta": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "usage"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "usage"
          ]
        },
        "usage": {
          "$ref": "#/definitions/Usage"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "stop_reason",
        "type"
      ],
      "properties": {
        "stop_reason": {
          "$ref": "#/definitions/StopReason"
        },
        "type": {
          "type": "string",
          "enum": [
            "completed"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "code",
        "message",
        "type"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "failed"
          ]
        }
      }
    }
  ],
  "definitions": {
    "Money": {
      "type": "object",
      "required": [
        "currency",
        "micros"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "micros": {
          "description": "Millionths of the currency unit; avoids floating-point accounting.",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "StopReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "end_turn",
            "max_tokens",
            "tool_use",
            "cancelled",
            "content_filter"
          ]
        },
        {
          "type": "object",
          "required": [
            "other"
          ],
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Usage": {
      "type": "object",
      "required": [
        "cached_tokens",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "cached_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/definitions/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
