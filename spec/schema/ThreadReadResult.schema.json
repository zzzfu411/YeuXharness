{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThreadReadResult",
  "type": "object",
  "required": [
    "events",
    "thread"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EventEnvelope"
      }
    },
    "nextAfterSeq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "thread": {
      "$ref": "#/definitions/Thread"
    }
  },
  "definitions": {
    "AgentResult": {
      "type": "object",
      "required": [
        "child_thread_id",
        "run_id",
        "state",
        "summary"
      ],
      "properties": {
        "child_thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "diff_artifact_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "default": null
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/definitions/AgentResultState"
        },
        "summary": {
          "type": "string"
        },
        "worktree_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "AgentResultState": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "budget_exhausted"
      ]
    },
    "AgentSpawnSpec": {
      "type": "object",
      "required": [
        "budget",
        "child_agent_id",
        "depth",
        "grant",
        "isolation",
        "parent_agent_id",
        "parent_thread_id",
        "run_id",
        "task",
        "workspace_id"
      ],
      "properties": {
        "budget": {
          "$ref": "#/definitions/RunBudget"
        },
        "child_agent_id": {
          "type": "string"
        },
        "depth": {
          "description": "v1 permits only `1`; kept explicit so the kernel can reject escalation.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "grant": {
          "$ref": "#/definitions/CapabilityGrant"
        },
        "isolation": {
          "$ref": "#/definitions/WorkspaceIsolation"
        },
        "parent_agent_id": {
          "type": "string"
        },
        "parent_thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "task": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "CapabilityGrant": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "external_write": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem_delete": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem_read": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem_write": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/definitions/CapabilityMode"
        },
        "network": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "default": false,
          "type": "boolean"
        },
        "secrets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CapabilityMode": {
      "type": "string",
      "enum": [
        "observe",
        "build",
        "operate"
      ]
    },
    "EffectSet": {
      "type": "object",
      "required": [
        "idempotency",
        "reversibility"
      ],
      "properties": {
        "external_writes": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExternalEffect"
          }
        },
        "filesystem_delete": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathScope"
          }
        },
        "filesystem_read": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathScope"
          }
        },
        "filesystem_write": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathScope"
          }
        },
        "idempotency": {
          "$ref": "#/definitions/Idempotency"
        },
        "network": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/NetworkEffect"
          }
        },
        "processes": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessEffect"
          }
        },
        "reversibility": {
          "$ref": "#/definitions/Reversibility"
        },
        "secrets": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/SecretHandle"
          }
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workspace/opened"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "workspace"
              ],
              "properties": {
                "workspace": {
                  "$ref": "#/definitions/Workspace"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workspace/trust_changed"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "trust",
                "workspace_id"
              ],
              "properties": {
                "trust": {
                  "$ref": "#/definitions/WorkspaceTrust"
                },
                "workspace_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "thread/started"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "thread"
              ],
              "properties": {
                "thread": {
                  "$ref": "#/definitions/Thread"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "thread/forked"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "thread"
              ],
              "properties": {
                "thread": {
                  "$ref": "#/definitions/Thread"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "thread/archived"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "thread_id"
              ],
              "properties": {
                "thread_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "turn/started"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "turn"
              ],
              "properties": {
                "turn": {
                  "$ref": "#/definitions/Turn"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "turn/state_changed"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "from",
                "to",
                "turn_id"
              ],
              "properties": {
                "from": {
                  "$ref": "#/definitions/TurnState"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "$ref": "#/definitions/TurnState"
                },
                "turn_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "turn/steered"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "message",
                "turn_id"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "turn_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "item/added"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "item"
              ],
              "properties": {
                "item": {
                  "$ref": "#/definitions/Item"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "model/requested"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "request_id"
              ],
              "properties": {
                "request_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "model/event"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "model_event",
                "request_id"
              ],
              "properties": {
                "model_event": {
                  "$ref": "#/definitions/ModelEvent"
                },
                "request_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool/proposed"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "call_id",
                "effect_digest",
                "effects",
                "idempotency",
                "invocation_id",
                "normalized_arguments_digest",
                "tool_id",
                "tool_version"
              ],
              "properties": {
                "call_id": {
                  "type": "string"
                },
                "effect_digest": {
                  "type": "string"
                },
                "effects": {
                  "$ref": "#/definitions/EffectSet"
                },
                "idempotency": {
                  "$ref": "#/definitions/Idempotency"
                },
                "invocation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "normalized_arguments_digest": {
                  "type": "string"
                },
                "tool_id": {
                  "type": "string"
                },
                "tool_version": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool/state_changed"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "from",
                "invocation_id",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/definitions/InvocationState"
                },
                "invocation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "$ref": "#/definitions/InvocationState"
                }
              }
            }
          }
        },
        {
          "description": "Explicitly resolves an invocation whose external outcome could not be proven after execution started. This event never authorizes a retry.",
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool/reconciled"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "evidence",
                "invocation_id",
                "outcome"
              ],
              "properties": {
                "evidence": {
                  "$ref": "#/definitions/InvocationReconciliationEvidence"
                },
                "invocation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "outcome": {
                  "$ref": "#/definitions/InvocationReconciliationOutcome"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "job/created"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "job"
              ],
              "properties": {
                "job": {
                  "$ref": "#/definitions/JobSpec"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "job/state_changed"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "from",
                "job_id",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/definitions/JobState"
                },
                "job_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "to": {
                  "$ref": "#/definitions/JobState"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "agent/spawned"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "spec"
              ],
              "properties": {
                "spec": {
                  "$ref": "#/definitions/AgentSpawnSpec"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "agent/completed"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "result"
              ],
              "properties": {
                "result": {
                  "$ref": "#/definitions/AgentResult"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "runtime/diagnostic"
              ]
            },
            "payload": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "recoverable": {
                  "default": false,
                  "type": "boolean"
                }
              }
            }
          }
        }
      ],
      "required": [
        "agent_id",
        "event_id",
        "schema_version",
        "seq",
        "thread_id",
        "time"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "$ref": "#/definitions/ProtocolVersion"
        },
        "seq": {
          "description": "Strictly monotonic within one thread. The first event has sequence 1.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "ExternalEffect": {
      "type": "object",
      "required": [
        "operation",
        "system"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "type": "string"
        }
      }
    },
    "Idempotency": {
      "type": "string",
      "enum": [
        "idempotent",
        "idempotent_with_key",
        "non_idempotent",
        "unknown"
      ]
    },
    "InvocationReconciliationEvidence": {
      "description": "Durable evidence explaining how an unknown invocation was reconciled.",
      "type": "object",
      "required": [
        "source",
        "summary"
      ],
      "properties": {
        "artifact_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Stable identifier for the reconciliation mechanism, such as an executor receipt lookup or an operator review workflow.",
          "type": "string"
        },
        "summary": {
          "description": "Bounded human-readable conclusion. Large receipts belong in the artifact store and are referenced by `artifact_uri`.",
          "type": "string"
        }
      }
    },
    "InvocationReconciliationOutcome": {
      "description": "A conclusion reached without executing an invocation again after its outcome became unknown.\n\nCancellation is intentionally absent: once execution may have produced a side effect, reconciliation must determine whether that effect completed or failed. It cannot retroactively claim that the invocation was cancelled.",
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    },
    "InvocationState": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "prepared",
        "started",
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "Item": {
      "type": "object",
      "required": [
        "agent_id",
        "content",
        "created_at",
        "id",
        "kind",
        "thread_id",
        "turn_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "content": true,
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/definitions/ItemKind"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "user_message",
        "assistant_message",
        "reasoning",
        "tool_call",
        "tool_result",
        "checkpoint",
        "diagnostic"
      ]
    },
    "JobSchedule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "at",
            "type"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "type": {
              "type": "string",
              "enum": [
                "at"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "every_seconds",
            "type"
          ],
          "properties": {
            "every_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "interval"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "rrule",
            "timezone",
            "type"
          ],
          "properties": {
            "rrule": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "rrule"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "manual"
              ]
            }
          }
        }
      ]
    },
    "JobSpec": {
      "type": "object",
      "required": [
        "budget",
        "grant",
        "id",
        "model",
        "name",
        "prompt",
        "provider",
        "schedule",
        "workspace_id"
      ],
      "properties": {
        "allow_reentry": {
          "default": false,
          "type": "boolean"
        },
        "budget": {
          "$ref": "#/definitions/RunBudget"
        },
        "grant": {
          "$ref": "#/definitions/CapabilityGrant"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "metadata": {
          "default": null
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "schedule": {
          "$ref": "#/definitions/JobSchedule"
        },
        "tool_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspace_id": {
          "type": "string",
