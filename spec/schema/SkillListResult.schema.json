      }
    }
  },
  "definitions": {
    "SkillDescriptor": {
      "type": "object",
      "required": [
        "contentDigest",
        "description",
        "id",
        "name",
        "source",
        "trusted"
      ],
      "properties": {
        "contentDigest": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean"
        }
      }
    }
  }
}
