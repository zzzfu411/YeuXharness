{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InitializeResult",
  "type": "object",
  "required": [
    "capabilities",
    "hostCeiling",
    "protocolVersion",
    "serverInfo"
  ],
  "properties": {
    "capabilities": {
      "$ref": "#/definitions/ServerCapabilities"
    },
    "hostCeiling": {
      "$ref": "#/definitions/CapabilityMode"
    },
    "protocolVersion": {
      "$ref": "#/definitions/ProtocolVersion"
    },
    "serverInfo": {
      "$ref": "#/definitions/ClientInfo"
    }
  },
  "definitions": {
    "CapabilityMode": {
      "type": "string",
      "enum": [
        "observe",
        "build",
        "operate"
      ]
    },
    "ClientInfo": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "ProtocolVersion": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "minor": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      }
    },
    "ServerCapabilities": {
      "type": "object",
      "properties": {
        "jobs": {
          "default": false,
          "type": "boolean"
        },
        "plugins": {
          "default": false,
          "type": "boolean"
        },
        "process_tools": {
          "default": false,
          "type": "boolean"
        },
        "process_tools_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "subagents": {
          "default": false,
          "type": "boolean"
        },
        "unix_socket": {
          "default": false,
          "type": "boolean"
        },
        "write_tools": {
          "description": "True only when the daemon has registered the M2 write pipeline and the required host sandbox is available.",
          "default": false,
          "type": "boolean"
        },
        "write_tools_reason": {
          "description": "Human-readable fail-closed explanation when a capability is not advertised. This is diagnostic context, never an authority grant.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
