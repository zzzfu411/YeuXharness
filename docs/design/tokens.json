{
  "version": 1,
  "direction": "paper-signal",
  "themes": {
    "paper": {
      "colorScheme": "light",
      "color": {
        "background": "#D8D3CC",
        "surface": "#E7E3DB",
        "surfaceLow": "#C6C0B6",
        "edge": "#B4ADA1",
        "text": "#1B1815",
        "textSoft": "#423C36",
        "textMuted": "#625B54",
        "border": "rgba(27, 24, 21, 0.34)",
        "focus": "#31566B",
        "focusShadow": "rgba(49, 86, 107, 0.28)",
        "approval": "#8C3A2C",
        "success": "#355F43",
        "warning": "#755719",
        "danger": "#8C3A2C"
      }
    },
    "nocturne": {
      "colorScheme": "dark",
      "color": {
        "background": "#080909",
        "surface": "#101214",
        "surfaceLow": "#171B1E",
        "edge": "#252A2E",
        "text": "#E2DED5",
        "textSoft": "#C0BBB1",
        "textMuted": "#99958D",
        "border": "#3B4145",
        "focus": "#6C9AB3",
        "focusShadow": "#173A52",
        "approval": "#D17968",
        "success": "#79A988",
        "warning": "#D0AB61",
        "danger": "#D17968"
      }
    }
  },
  "glyph": {
    "brandCompact": "><",
    "accepted": "·",
    "buildingContext": "◌",
    "requestingModel": "↗",
    "streaming": "≈",
    "toolProposed": "◇",
    "waitingApproval": "?",
    "authorized": "◆",
    "executing": "▶",
    "integrating": "∿",
    "completed": "✓",
    "failed": "×",
    "cancelled": "—",
    "unknown": "!",
    "rail": "│",
    "branch": "├",
    "end": "└",
    "prompt": "›"
  },
  "geometry": {
    "radiusPx": 3,
    "borderPx": 1,
    "strongBorderPx": 2,
    "focusShadowPx": [3, 3],
    "maxContentWidthPx": 1180
  },
  "motion": {
    "maxContinuousFps": 4,
    "settleMs": 180,
    "themeTransitionMs": 220,
    "allowMultipleContinuousAnimations": false,
    "defaultSound": "off"
  },
  "terminal": {
    "breakpoints": {
      "lineModeMaxColumns": 79,
      "singlePaneMaxColumns": 119,
      "inspectorMinColumns": 120
    },
    "fallbackOrder": [
      "truecolor",
      "ansi256",
      "ansi16",
      "monochrome"
    ],
    "respect": [
      "NO_COLOR",
      "TERM=dumb",
      "non-tty",
      "reduced-motion",
      "ascii-only"
    ]
  }
}
