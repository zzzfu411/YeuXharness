{
  "version": 2,
  "direction": "paper-signal",
  "defaultTheme": "nocturne",
  "brand": {
    "character": "yuzai-fish-people",
    "composition": "back-to-back-heads-outward-tails-inward",
    "compactMark": "><",
    "paperAsset": "assets/brand/yeux-fish-doodle-paper-v2.png",
    "nocturneAsset": "assets/brand/yeux-fish-doodle-nocturne-v2.png",
    "fallbackAsset": "assets/brand/yeux-fish-doodle-fallback.svg",
    "deprecatedAsset": "assets/brand/yeux-signal-fish-v1.png",
    "imagePolicy": "welcome-about-release-only",
    "forbidden": [
      "center-spark",
      "signal-wave",
      "event-rail-in-character",
      "infinity-symbol",
      "mirror-symmetry",
      "ornate-fins",
      "scales",
      "glow"
    ]
  },
  "themes": {
    "paper": {
      "colorScheme": "light",
      "color": {
        "background": "#D8D3CC",
        "surface": "#E7E3DB",
        "surfaceLow": "#C6C0B6",
        "edge": "#B4ADA1",
        "text": "#1B1815",
        "brandInk": "#1B1815",
        "textSoft": "#423C36",
        "textMuted": "#625B54",
        "border": "rgba(27, 24, 21, 0.34)",
        "focus": "#31566B",
        "focusShadow": "rgba(49, 86, 107, 0.28)",
        "approval": "#8C3A2C",
        "success": "#355F43",
        "warning": "#755719",
        "danger": "#8C3A2C"
      }
    },
    "nocturne": {
      "colorScheme": "dark",
      "color": {
        "background": "#080909",
        "surface": "#101214",
        "surfaceLow": "#171B1E",
        "edge": "#252A2E",
        "text": "#E2DED5",
        "brandInk": "#D9D4C9",
        "duskPaper": "#2A2733",
        "waveQuiet": "#5F968F",
        "textSoft": "#C0BBB1",
        "textMuted": "#99958D",
        "border": "#3B4145",
        "focus": "#6C9AB3",
        "focusShadow": "#173A52",
        "approval": "#D17968",
        "success": "#79A988",
        "warning": "#D0AB61",
        "danger": "#D17968"
      }
    }
  },
  "glyph": {
    "brandCompact": "><",
    "accepted": "·",
    "buildingContext": "◌",
    "requestingModel": "↗",
    "streaming": "≈",
    "toolProposed": "◇",
    "waitingApproval": "?",
    "authorized": "◆",
    "executing": "▶",
    "integrating": "∿",
    "completed": "✓",
    "failed": "×",
    "cancelled": "—",
    "unknown": "!",
    "rail": "│",
    "branch": "├",
    "end": "└",
    "prompt": "›",
    "ascii": {
      "brandCompact": "><",
      "accepted": ".",
      "buildingContext": "o",
      "requestingModel": "->",
      "streaming": "~",
      "toolProposed": "o",
      "waitingApproval": "?",
      "authorized": "*",
      "executing": ">",
      "integrating": "~",
      "completed": "OK",
      "failed": "ERR",
      "cancelled": "--",
      "unknown": "!!",
      "rail": "|",
      "branch": "+-",
      "end": "`-",
      "prompt": ">"
    }
  },
  "geometry": {
    "radiusPx": 3,
    "borderPx": 1,
    "strongBorderPx": 2,
    "focusShadowPx": [3, 3],
    "maxContentWidthPx": 1180
  },
  "motion": {
    "maxContinuousFps": 4,
    "settleMs": 180,
    "themeTransitionMs": 220,
    "allowMultipleContinuousAnimations": false,
    "defaultSound": "off"
  },
  "terminal": {
    "defaultTheme": "nocturne",
    "breakpoints": {
      "compactMaxColumns": 39,
      "lineModeMaxColumns": 79,
      "singlePaneMaxColumns": 119,
      "inspectorMinColumns": 120,
      "wideInspectorMinColumns": 160
    },
    "fallbackOrder": [
      "truecolor",
      "ansi256",
      "ansi16",
      "monochrome"
    ],
    "respect": [
      "NO_COLOR",
      "TERM=dumb",
      "non-tty",
      "reduced-motion",
      "ascii-only"
    ],
    "plainTriggers": [
      "non-tty",
      "TERM=dumb",
      "CI=true",
      "--plain",
      "--jsonl"
    ],
    "animation": {
      "maxContinuousFps": 4,
      "maxConcurrentFocus": 1,
      "disabledFor": ["NO_COLOR", "TERM=dumb", "non-tty", "reduced-motion", "screen-reader"]
    }
  },
  "web": {
    "defaultTheme": "nocturne",
    "breakpointsPx": {
      "singleColumn": 767,
      "drawer": 1179,
      "instrument": 1180
    },
    "imagePolicy": "optional-welcome-only"
  }
}
